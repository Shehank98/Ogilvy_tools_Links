# PostgreSQL connection string (Railway provides this as DATABASE_URL)
DATABASE_URL="postgresql://user:password@localhost:5432/toolshub"

# Shared admin password for the /admin section
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie (any long random string)
SESSION_SECRET="change-me-too"

# --- Staff sign-in & ticket emails -------------------------------------------
# Sign-up codes and ticket emails are sent through the Google Apps Script relay
# in /apps-script (see apps-script/README.md). Without these two values, local
# development just prints the emails to the console; production will refuse to
# send.
APPS_SCRIPT_URL=""
APPS_SCRIPT_SECRET=""
# Comma-separated email domains allowed to create accounts (default: ogilvy.com)
ALLOWED_EMAIL_DOMAINS="ogilvy.com"
# Optional: get an email whenever someone raises a ticket
ADMIN_NOTIFY_EMAIL=""
# Optional: public URL of this app, used for links inside emails
APP_URL=""

# --- Ticket attachments (Firebase Storage) -----------------------------------
# Files uploaded with a bug report are stored under tickets/<TICKET-NO>/ and are
# deleted automatically when the ticket is set to Done or Closed.
# Leave these empty to switch uploads off (the attach button is then hidden).
FIREBASE_STORAGE_BUCKET=""            # e.g. my-project.firebasestorage.app (no gs://)
FIREBASE_SERVICE_ACCOUNT=""           # the whole service-account .json file, pasted as-is
# FIREBASE_SERVICE_ACCOUNT_BASE64=""  # alternative if pasting JSON is awkward: base64 of that file
# Safety-net clean-up job (see README): call /api/cron/purge-files with this secret
CRON_SECRET=""
# Local development only: store uploads on disk instead of Firebase
# STORAGE_DRIVER=local
