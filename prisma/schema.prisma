generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tool {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  link        String
  description String?
  category    String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  isBeta      Boolean  @default(false)
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive, order])
}

enum NoticeType {
  INFO
  UPDATE
  BUGFIX
  WARNING
}

model Notice {
  id        String     @id @default(cuid())
  message   String
  type      NoticeType @default(INFO)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([isActive, createdAt])
}

model Upcoming {
  id          String   @id @default(cuid())
  name        String
  bannerUrl   String?
  description String?
  category    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  voteCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

enum FeedbackTarget {
  TOOL
  UPCOMING
  GENERAL
}

enum FeedbackKind {
  SUGGESTION
  BUG
  IDEA
}

enum FeedbackStatus {
  NEW
  REVIEWING
  PLANNED
  DONE
  DISMISSED
}

enum FeedbackPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// A piece of feedback is also a "ticket" once it comes from a signed-in user:
// it gets a ticket number, can be tracked by its author and carries a history.
model Feedback {
  id         String           @id @default(cuid())
  ticketNo   Int              @unique @default(autoincrement())
  targetType FeedbackTarget
  targetId   String
  targetName String
  kind       FeedbackKind     @default(SUGGESTION)
  title      String?
  priority   FeedbackPriority @default(MEDIUM)
  message    String
  steps      String?
  email      String?
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  status     FeedbackStatus   @default(NEW)
  adminNotes String?
  // Shown to the requester on their ticket (adminNotes stays internal).
  publicNote String?
  // Team members this ticket is assigned to (names from src/lib/team.ts).
  assignedTo String[]         @default([])
  events     FeedbackEvent[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status])
  @@index([targetType, targetId])
  @@index([userId, createdAt])
}

model FeedbackEvent {
  id         String         @id @default(cuid())
  feedbackId String
  feedback   Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  status     FeedbackStatus
  note       String?
  createdAt  DateTime       @default(now())

  @@index([feedbackId, createdAt])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  verified     Boolean       @default(false)
  failedLogins Int           @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     UserSession[]
  feedback     Feedback[]
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum EmailCodePurpose {
  VERIFY
  RESET
}

model EmailCode {
  id          String           @id @default(cuid())
  email       String
  purpose     EmailCodePurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int              @default(0)
  sendCount   Int              @default(1)
  windowStart DateTime         @default(now())

  @@unique([email, purpose])
}

model Workshop {
  id              String   @id @default(cuid())
  title           String
  description     String?
  dateTime        DateTime
  location        String?
  interestedCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([dateTime])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  body          String
  coverImageUrl String?
  status        PostStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, publishedAt])
}

enum RequestFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum RequestStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  BUILT
}

model ToolRequest {
  id                 String           @id @default(cuid())
  requesterName      String
  requesterEmail     String
  toolName           String
  taskDescription    String
  frequency          RequestFrequency
  estimatedTimeSaved String?
  attachmentUrl      String?
  status             RequestStatus    @default(NEW)
  adminNotes         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([requesterEmail])
  @@index([status])
}
