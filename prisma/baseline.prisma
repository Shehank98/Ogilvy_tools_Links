generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tool {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  link        String
  description String?
  category    String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  isBeta      Boolean  @default(false)
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive, order])
}

enum NoticeType {
  INFO
  UPDATE
  BUGFIX
  WARNING
}

model Notice {
  id        String     @id @default(cuid())
  message   String
  type      NoticeType @default(INFO)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([isActive, createdAt])
}

model Upcoming {
  id          String   @id @default(cuid())
  name        String
  bannerUrl   String?
  description String?
  category    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  voteCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

enum FeedbackTarget {
  TOOL
  UPCOMING
}

enum FeedbackKind {
  SUGGESTION
  BUG
  IDEA
}

enum FeedbackStatus {
  NEW
  REVIEWING
  PLANNED
  DONE
  DISMISSED
}

model Feedback {
  id         String         @id @default(cuid())
  targetType FeedbackTarget
  targetId   String
  targetName String
  kind       FeedbackKind   @default(SUGGESTION)
  message    String
  email      String?
  status     FeedbackStatus @default(NEW)
  adminNotes String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status])
  @@index([targetType, targetId])
}

model Workshop {
  id              String   @id @default(cuid())
  title           String
  description     String?
  dateTime        DateTime
  location        String?
  interestedCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([dateTime])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  body          String
  coverImageUrl String?
  status        PostStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, publishedAt])
}

enum RequestFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum RequestStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  BUILT
}

model ToolRequest {
  id                 String           @id @default(cuid())
  requesterName      String
  requesterEmail     String
  toolName           String
  taskDescription    String
  frequency          RequestFrequency
  estimatedTimeSaved String?
  attachmentUrl      String?
  status             RequestStatus    @default(NEW)
  adminNotes         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([requesterEmail])
  @@index([status])
}
